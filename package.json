{
  "name": "voicebridge-studio",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"vite\" \"wait-on tcp:4173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:backend:win": "powershell -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "prepare:runtime:win": "powershell -ExecutionPolicy Bypass -File scripts/prepare-runtime.ps1",
    "package:win": "npm run build && npm run build:backend:win && npm run prepare:runtime:win && electron-builder --win nsis --publish never",
    "release:win": "npm run build && npm run build:backend:win && npm run prepare:runtime:win && electron-builder --win nsis --publish never",
    "preview": "vite preview",
    "test:api": "python -m pytest server -q",
    "test:desktop": "node --test desktop/test-*.cjs"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron-updater": "^6.8.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "studio.voicebridge.desktop",
    "productName": "VoiceBridge Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "**/*.md"
        ]
      },
      {
        "from": "build/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "services/seamless-sidecar",
        "to": "sidecar",
        "filter": [
          "Dockerfile",
          "requirements.txt",
          "app.py"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VoiceBridge-Studio-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jiangheli",
        "repo": "voicebridge-studio",
        "releaseType": "release"
      }
    ]
  }
}
